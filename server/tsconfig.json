{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true, // Enable better compatibility with ES modules
    "strict": true, // Enable strict type-checking options
    "skipLibCheck": true, // Skip type-checking of library files
    "types": ["bun"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"] // General alias for the `src` directory
    }
  },
  "include": ["src/**/*", "drizzle.config.ts", "vitest.config.mts"],
  "exclude": ["node_modules"]
}
